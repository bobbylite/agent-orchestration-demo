# Everything below is optional and independent. This service runs with its
# own UI's "Sign in with PingOne" hidden until the OIDC block is fully
# populated; the MCP endpoint itself always requires a valid delegated
# token from a caller in ALLOWED_AGENT_CLIENT_ID once AGENT_EXPECTED_AUDIENCE
# is set — there is no "trusted network" fallback anymore.

# --- OIDC (PingOne) — "Sign in with PingOne" for this service's own UI ----
# Create a THIRD, dedicated PingOne application (OIDC Web App) — separate
# from backend/'s sign-in app and its worker app — with:
#   Redirect URI:             http://localhost:9000/api/auth/callback
#   Post-logout redirect URI: http://localhost:5174
#   Grant type: Authorization Code, PKCE required (S256)
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=53a60d89-5c38-408d-9363-be17721136f9
OIDC_CLIENT_SECRET=
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5174
OIDC_SCOPES=openid profile email

# Any long random string; hashed to a 32-byte key for JWE A256GCM. Required
# to use OIDC login. A different value than backend/task-agent's — this
# service's session cookie is its own, not shared.
SESSION_SECRET=

# --- Inbound auth for delegated tokens forwarded by task-agent -------------
# This service independently re-verifies the SAME delegated token
# task-agent already verified (see CLAUDE.md "Identity propagation across
# the A2A hop") — these must match backend/.env's and task-agent/.env's
# values exactly, a third copy of the same "must match" requirement.
# OIDC_DISCOVERY_URL above is reused for both purposes (human sign-in *and*
# verifying delegated tokens) — same PingOne tenant either way.
AGENT_EXPECTED_AUDIENCE=

# backend/.env's AGENT_CLIENT_ID — the identity that shows up once a
# delegated token is verified (the Chat Agent forwards the same token
# unchanged all the way through task-agent to here, so this is the same
# value task-agent/.env's ALLOWED_AGENT_CLIENT_ID uses). Drives
# app/policy.py's ACL.
ALLOWED_AGENT_CLIENT_ID=

# Must match task-agent/.env's TODOS_READ_SCOPE / TODOS_WRITE_SCOPE /
# TODOS_DELETE_SCOPE exactly. Backend does not request todo capability scopes.
TODOS_READ_SCOPE=todos:read
TODOS_WRITE_SCOPE=todos:write
TODOS_DELETE_SCOPE=todos:delete

# Friendly label for the audit log ("Agent Task Agent used ..." instead of
# a raw client_id). Cosmetic only.
AGENT_DISPLAY_NAME=Task Agent

# --- Networking --------------------------------------------------------------
APP_BASE_URL=http://localhost:9000
FRONTEND_ORIGIN=http://localhost:5174
