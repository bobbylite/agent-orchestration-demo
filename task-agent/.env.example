# --- Inbound: the delegation credential the Chat Agent forwards -----------
OIDC_DISCOVERY_URL=
# This service's OWN URL — the delegation token must be addressed here,
# not to backend/'s own audience. Must match backend/.env's
# AGENT_EXPECTED_AUDIENCE (which is now the Task Agent's audience too, not
# a shared "task-agent" label) and the resource behind
# AGENT_DELEGATION_SCOPE there.
AGENT_EXPECTED_AUDIENCE=http://localhost:9010
# The delegation token's own scope must contain exactly this. Must match
# backend/.env's AGENT_DELEGATION_SCOPE exactly.
EXPECTED_DELEGATION_SCOPE=agent:delegation

# The client_id claim on that inbound token — whichever PingOne worker app
# actually PERFORMED the Token Exchange that produced it. That's
# backend/.env's AGENT_DELEGATION_CLIENT_ID, NOT AGENT_CLIENT_ID — the two
# are deliberately different PingOne apps now. Drives policy.py's ACL.
ALLOWED_AGENT_CLIENT_ID=

# --- This service's own identity ("agent:task") ----------------------------
# Create a PingOne application (Worker/Service app) with:
#   Grant type: Client Credentials
#   Token endpoint auth method: client_secret_basic
TASK_AGENT_CLIENT_ID=
TASK_AGENT_CLIENT_SECRET=
# Scoped to "I am the Task Agent" — must be defined on a PingOne resource
# whose audience is THIS service's own URL (same as AGENT_EXPECTED_AUDIENCE
# above). Produces the actor token used as input to the MCP-scoped Token
# Exchange below; never sent anywhere on its own.
AGENT_TASK_SCOPE=agent:task

# --- Token Exchange against the MCP server ---------------------------------
# Create ANOTHER PingOne application (Worker/Service app) with:
#   Grant type: Token Exchange
#   Token endpoint auth method: client_secret_basic
TODOS_MCP_CLIENT_ID=
TODOS_MCP_CLIENT_SECRET=
# The MCP server's own audience — must match mcp-todos-server/.env's
# AGENT_EXPECTED_AUDIENCE exactly.
MCP_TODOS_AUDIENCE=http://localhost:9000/mcp
# What's actually requested from the exchange above, per tool call — this
# service's own decision now, not inherited from an upstream scope. Must
# match mcp-todos-server/.env's TODOS_READ_SCOPE / TODOS_WRITE_SCOPE
# exactly — that's what independently checks the granted scope on every
# MCP tool call. Requested fresh per call (not cached across different
# scopes), so asking for todos:write later never depends on whether an
# earlier todos:read call succeeded.
TODOS_READ_SCOPE=todos:read
TODOS_WRITE_SCOPE=todos:write

# --- PingOne Authorize group decision ---------------------------------------
# The deployed Decision Endpoint invoked before any MCP-scoped token exchange.
AUTHORIZE_DECISION_ENDPOINT=https://api.pingone.com/v1/environments/<environment-id>/decisionEndpoints/<decision-endpoint-id>
# Worker application used to authenticate the decision request with OAuth2 Client Credentials.
AUTHORIZE_CLIENT_ID=
AUTHORIZE_CLIENT_SECRET=
# PingOne token endpoint auth method for this worker app.
AUTHORIZE_CLIENT_AUTH_METHOD=client_secret_post
# OpenID scope/resource used by the decision endpoint.
AUTHORIZE_SCOPE=https://api.pingone.com/v1/environments/<environment-id>/decisionEndpoints/<decision-endpoint-id>
# The endpoint introspects the delegated token below to resolve the human subject,
# agent_client_id, and group membership. Do not send the human token as the
# Authorization header; that header carries the Authorize worker token.
AUTHORIZE_DELEGATE_TASKS_POLICY_PARAMETER=evaluateDelegateTasksPolicy
AUTHORIZE_DELEGATE_TASKS_POLICY_VALUE=true
# Evaluates the freshly exchanged todos:read/todos:write token before MCP.
AUTHORIZE_TASK_POLICY_PARAMETER=evaluateTaskPolicy
AUTHORIZE_TASK_POLICY_VALUE=true

ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
# "anthropic" (default, uses ANTHROPIC_API_KEY + AGENT_MODEL above),
# "openai" (uses OPENAI_API_KEY + MODEL_ID below), or "groq" (uses
# GROQ_API_KEY below + MODEL_ID, free tier) — which provider
# task_assistant itself reasons with. Unrelated to this service's own
# PingOne identity/delegation chain above, which is unaffected either way.
MODEL_PROVIDER=anthropic
OPENAI_API_KEY=
MODEL_ID=gpt-4.1
# GROQ_MODEL is its own field (not MODEL_ID), used only when
# MODEL_PROVIDER=groq — kept separate so both can stay set at once
# without one becoming stale model text for the other provider.
GROQ_MODEL=llama-3.3-70b-versatile

# --- Judge node (app/graph.py) ---------------------------------------------
# "anthropic" (default, uses ANTHROPIC_API_KEY + AGENT_MODEL above),
# "groq", or "openai" (reuses OPENAI_API_KEY/MODEL_ID above) — the judge
# only reads text and returns a structured verdict, no tool calls of its
# own, so it doesn't need to be on the same provider as task_assistant.
# Groq's free tier (console.groq.com, no card required) is genuinely free
# — rate-limited, not credit-metered.
JUDGE_PROVIDER=anthropic
# Shared by both MODEL_PROVIDER=groq (task_assistant) and
# JUDGE_PROVIDER=groq (the judge) — same underlying Groq account either way.
GROQ_API_KEY=
# Leave unset to use AGENT_MODEL (anthropic), llama-3.3-70b-versatile
# (groq), or gpt-4o-mini (openai) automatically.
JUDGE_MODEL=
# The evaluator-optimizer Authorize policy supplies the effective total
# judge-attempt budget through a policy-information statement payload.
# JUDGE_MAX_ATTEMPTS remains the local fallback when no valid budget is returned.
JUDGE_MAX_ATTEMPTS=2

# --- LangSmith tracing (optional) -------------------------------------------
# Purely additive to this service's own OpenTelemetry spans (Telemetry
# panel) — off by default, zero behavior change when unset. When enabled,
# every LLM call this service's graph makes is traced to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
# Use the SAME project name in both backend/.env and task-agent/.env so a
# demo session's traces from both agents land in one LangSmith project (they
# will NOT merge into a single trace tree — see CLAUDE.md for why).
LANGSMITH_PROJECT=Todos

MCP_TODOS_URL=http://localhost:9000/mcp

HOST=0.0.0.0
PORT=9010
PUBLIC_URL=http://localhost:9010
