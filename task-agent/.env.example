# This agent verifies the SAME delegated token the Chat Agent (backend/)
# already holds — these two must match backend/.env's values exactly.
OIDC_DISCOVERY_URL=
AGENT_EXPECTED_AUDIENCE=

# The Chat Agent's own client_id (backend/.env's AGENT_CLIENT_ID) — the
# identity that shows up once the token is verified. Drives policy.py's ACL.
ALLOWED_AGENT_CLIENT_ID=

# Must match backend/.env's TODOS_READ_SCOPE / TODOS_WRITE_SCOPE exactly —
# policy.py checks the verified token's own `scope` claim against these
# before allowing list_todos (read) vs add_todo/complete_todo (write).
TODOS_READ_SCOPE=todos:read
TODOS_WRITE_SCOPE=todos:write

ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5

MCP_TODOS_URL=http://localhost:9000/mcp

HOST=0.0.0.0
PORT=9010
PUBLIC_URL=http://localhost:9010
