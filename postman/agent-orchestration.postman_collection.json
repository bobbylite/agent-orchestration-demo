{
  "info": {
    "name": "Agent Orchestration Console",
    "description": "Smoke and functional tests for the chat frontend, backend, Task Agent, MCP Todos server, and Todos UI. OIDC login is intentionally a manual browser step; Postman then reuses its cookies for the protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.variables.get('thread_id')) {",
          "  pm.variables.set('thread_id', 'postman-' + Date.now());",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "console_url", "value": "https://rluisi-agent-orchestration-client.ping-devops.com" },
    { "key": "todos_url", "value": "https://rluisi-agent-orchestration-todos.ping-devops.com" },
    { "key": "thread_id", "value": "" },
    { "key": "todo_id", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Public health and UI smoke tests",
      "item": [
        {
          "name": "Chat frontend",
          "request": { "method": "GET", "header": [], "url": "{{console_url}}/" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Chat frontend returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Chat frontend returns HTML', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'); });"
          ] } }]
        },
        {
          "name": "Chat backend health",
          "request": { "method": "GET", "header": [], "url": "{{console_url}}/api/health" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Backend health returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Backend health is ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
          ] } }]
        },
        {
          "name": "Todos UI",
          "request": { "method": "GET", "header": [], "url": "{{todos_url}}/" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Todos UI returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Todos UI returns HTML', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'); });"
          ] } }]
        },
        {
          "name": "MCP server health through Todos UI",
          "request": { "method": "GET", "header": [], "url": "{{todos_url}}/api/health" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('MCP health returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('MCP health is ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
          ] } }]
        }
      ]
    },
    {
      "name": "02 - Authentication",
      "description": "Run the login requests with redirect following disabled, then open the Location URL in a browser. After completing PingOne login, import the cookies into Postman or use the Postman cookie jar for the same host.",
      "item": [
        {
          "name": "Start chat PingOne login",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{console_url}}/api/auth/login",
            "protocolProfileBehavior": { "followRedirects": false }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Login returns a redirect', function () { pm.expect([302, 303, 307, 308]).to.include(pm.response.code); });",
            "console.log('Open this Location in a browser to complete PingOne login:', pm.response.headers.get('Location'));"
          ] } }]
        },
        {
          "name": "Chat session status",
          "request": { "method": "GET", "header": [], "url": "{{console_url}}/api/auth/me" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Chat auth endpoint returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('OIDC is enabled', function () { pm.expect(pm.response.json().oidc_enabled).to.eql(true); });"
          ] } }]
        },
        {
          "name": "Start Todos PingOne login",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{todos_url}}/api/auth/login",
            "protocolProfileBehavior": { "followRedirects": false }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Todos login returns a redirect', function () { pm.expect([302, 303, 307, 308]).to.include(pm.response.code); });",
            "console.log('Open this Location in a browser to complete PingOne login:', pm.response.headers.get('Location'));"
          ] } }]
        },
        {
          "name": "Todos session status",
          "request": { "method": "GET", "header": [], "url": "{{todos_url}}/api/auth/me" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Todos auth endpoint returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('OIDC is enabled', function () { pm.expect(pm.response.json().oidc_enabled).to.eql(true); });"
          ] } }]
        }
      ]
    },
    {
      "name": "03 - Task Agent and telemetry",
      "item": [
        {
          "name": "Task Agent telemetry proxy",
          "request": { "method": "GET", "header": [], "url": "{{console_url}}/task-agent-api/telemetry" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Task Agent telemetry returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Telemetry has spans array', function () { pm.expect(pm.response.json().spans).to.be.an('array'); });"
          ] } }]
        },
        {
          "name": "Task Agent token chain proxy",
          "request": { "method": "GET", "header": [], "url": "{{console_url}}/task-agent-api/tokens/chain" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Task Agent token chain returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Token chain has task agent slot', function () { pm.expect(pm.response.json()).to.have.property('task_agent_own'); });"
          ] } }]
        },
        {
          "name": "PingOne Authorize decision history proxy",
          "request": { "method": "GET", "header": [], "url": "{{console_url}}/task-agent-api/authorize/decisions" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Authorize history returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Authorize history has entries array', function () { pm.expect(pm.response.json().entries).to.be.an('array'); });"
          ] } }]
        },
        {
          "name": "Chat backend telemetry",
          "request": { "method": "GET", "header": [], "url": "{{console_url}}/api/telemetry" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Backend telemetry returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Backend telemetry has spans array', function () { pm.expect(pm.response.json().spans).to.be.an('array'); });"
          ] } }]
        }
      ]
    },
    {
      "name": "04 - Agent delegation",
      "description": "Requires a signed-in chat session. Approve delegation first, then invoke a todo request. The invoke endpoint streams SSE; Postman should display the event stream in the response body.",
      "item": [
        {
          "name": "Approve Chat Agent delegation",
          "request": { "method": "POST", "header": [], "url": "{{console_url}}/api/auth/agent-token", "body": { "mode": "raw", "raw": "", "options": { "raw": { "language": "text" } } } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Delegation approval succeeds', function () { pm.response.to.have.status(200); });",
            "pm.test('Delegation is true', function () { pm.expect(pm.response.json().delegated).to.eql(true); });"
          ] } }]
        },
        {
          "name": "Chat Agent token chain",
          "request": { "method": "GET", "header": [], "url": "{{console_url}}/api/auth/token-chain" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Chat token chain returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Delegation token was recorded', function () { pm.expect(pm.response.json().delegation).to.not.eql(null); });"
          ] } }]
        },
        {
          "name": "Invoke Task Agent through chat",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "text/event-stream" }],
            "url": "{{console_url}}/api/invoke",
            "body": { "mode": "raw", "raw": "{\n  \"thread_id\": \"{{thread_id}}\",\n  \"message\": \"List my todos and summarize which ones are incomplete.\"\n}", "options": { "raw": { "language": "json" } } }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Invoke returns SSE', function () { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream'); });",
            "pm.test('Invoke produced output', function () { pm.expect(pm.response.text()).to.include('event:'); });"
          ] } }]
        },
        {
          "name": "Verify telemetry after delegation",
          "request": { "method": "GET", "header": [], "url": "{{console_url}}/task-agent-api/telemetry" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Task Agent telemetry returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Task Agent emitted spans', function () { pm.expect(pm.response.json().spans.length).to.be.above(0); });"
          ] } }]
        },
        {
          "name": "Verify Authorize decisions after delegation",
          "request": { "method": "GET", "header": [], "url": "{{console_url}}/task-agent-api/authorize/decisions" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Authorize history returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Authorize decisions were recorded', function () { pm.expect(pm.response.json().entries.length).to.be.above(0); });"
          ] } }]
        }
      ]
    },
    {
      "name": "05 - Todos UI and MCP REST API",
      "description": "Requires a signed-in Todos UI session. These requests exercise the human REST path. Agent MCP calls are exercised by the delegation folder above and appear in the audit log.",
      "item": [
        {
          "name": "List todos",
          "request": { "method": "GET", "header": [], "url": "{{todos_url}}/api/todos" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('List todos returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Todos response has todos array', function () { pm.expect(pm.response.json().todos).to.be.an('array'); });"
          ] } }]
        },
        {
          "name": "Add human todo",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{todos_url}}/api/todos",
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"Postman human-path smoke test\"\n}", "options": { "raw": { "language": "json" } } }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Add todo returns 200', function () { pm.response.to.have.status(200); });",
            "const todo = pm.response.json();",
            "pm.expect(todo).to.have.property('id');",
            "pm.collectionVariables.set('todo_id', todo.id);"
          ] } }]
        },
        {
          "name": "Complete human todo",
          "request": { "method": "POST", "header": [], "url": "{{todos_url}}/api/todos/{{todo_id}}/complete" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Complete todo returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Todo is done', function () { pm.expect(pm.response.json().done).to.eql(true); });"
          ] } }]
        },
        {
          "name": "Read audit log",
          "request": { "method": "GET", "header": [], "url": "{{todos_url}}/api/audit" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Audit log returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Audit response has entries array', function () { pm.expect(pm.response.json().entries).to.be.an('array'); });"
          ] } }]
        },
        {
          "name": "Verify agent audit entry",
          "request": { "method": "GET", "header": [], "url": "{{todos_url}}/api/audit" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const entries = pm.response.json().entries || [];",
            "pm.test('At least one audit entry exists', function () { pm.expect(entries.length).to.be.above(0); });",
            "pm.test('Agent audit entry is present', function () { pm.expect(entries.some(function (entry) { return entry.actor_type === 'agent'; })).to.eql(true); });"
          ] } }]
        }
      ]
    }
  ]
}
