# Everything below is optional and independent. The console runs with the
# PingOne sign-in and Authenticate Agent buttons hidden until their block
# of variables is fully populated.

# --- OIDC (PingOne) — "Sign in with PingOne" -------------------------------
# Create a PingOne application (OIDC Web App) with:
#   Redirect URI:            http://localhost:8000/api/auth/callback
#   Post-logout redirect URI: http://localhost:5173
#   Grant type: Authorization Code, PKCE required (S256)
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173

# --- Agent identity — "Authenticate Agent" (Client Credentials + RFC 8693) -
# Create a SECOND PingOne application (Worker/Service app) with:
#   Grant types: Client Credentials, Token Exchange
#   Token endpoint auth method: client_secret_basic
AGENT_CLIENT_ID=
AGENT_CLIENT_SECRET=

# --- Session cookie encryption (required if either block above is used) ---
# Any long random string; it's hashed to a 32-byte key for JWE A256GCM.
SESSION_SECRET=

# --- LangGraph agent --------------------------------------------------------
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5

# --- Networking --------------------------------------------------------------
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
