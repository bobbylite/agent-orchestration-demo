# This bridge reuses the Chat Agent's own PingOne identity — copy these
# values straight from backend/.env, they're the SAME apps (#1, #2, #3
# from README.md's "PingOne setup"). This isn't a shortcut: this bridge
# genuinely *is* the Chat Agent's identity, just running as a local
# process Claude Desktop spawns instead of backend/'s FastAPI service.

# --- App #1 — user sign-in (same values as backend/.env's OIDC_*) --------
# One extra step vs backend/: PingOne app #1 needs a SECOND redirect URI
# registered, alongside http://localhost:8000/api/auth/callback:
#   http://localhost:8765/callback   (or whatever LOCAL_CALLBACK_PORT is)
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email

# --- App #2 — this bridge's own identity (same as backend/.env's AGENT_*) -
AGENT_CLIENT_ID=
AGENT_CLIENT_SECRET=
AGENT_OWN_SCOPE=agent:orchestration

# --- App #3 — delegation Token Exchange (same as backend/.env's AGENT_DELEGATION_*) -
AGENT_DELEGATION_CLIENT_ID=
AGENT_DELEGATION_CLIENT_SECRET=
AGENT_DELEGATION_SCOPE=agent:delegation

# --- A2A: the Task Agent this bridge delegates to ---------------------------
TASK_AGENT_URL=http://localhost:9010

# --- Loopback OAuth callback for the one-time browser sign-in ---------------
# Must match a redirect URI registered on PingOne app #1 (see above).
LOCAL_CALLBACK_PORT=8765
