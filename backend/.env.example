# Everything below is optional and independent. The console runs with the
# PingOne sign-in and Authenticate Agent buttons hidden until their block
# of variables is fully populated.

# --- OIDC (PingOne) — "Sign in with PingOne" -------------------------------
# Create a PingOne application (OIDC Web App) with:
#   Redirect URI:            http://localhost:8000/api/auth/callback
#   Post-logout redirect URI: http://localhost:5173
#   Grant type: Authorization Code, PKCE required (S256)
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173
# Space-delimited scopes requested at sign-in. "openid" is required (it's
# what makes this OIDC rather than bare OAuth); add scopes here if the
# resulting access_token also needs to work as the `subject_token` for a
# broader token exchange than what profile/email alone would grant.
OIDC_SCOPES=openid profile email

# --- Agent identity — "Approve Agent Action" (Client Credentials + RFC 8693) -
# TWO separate PingOne worker apps — the one that proves the Chat Agent's
# own identity is deliberately not the same one authorized to perform
# Token Exchange, mirroring how a real deployment would separate "an agent
# proving who it is" from "a privileged client allowed to mint delegated
# tokens."

# App #2a — Client Credentials only. Token endpoint auth: client_secret_basic.
AGENT_CLIENT_ID=
AGENT_CLIENT_SECRET=
# Scoped to "I am the orchestration agent" — must be defined as a scope on
# a PingOne resource whose audience is THIS service's own URL
# (APP_BASE_URL below). Produces the actor token used as input to the
# Token Exchange call below; never sent anywhere on its own.
AGENT_OWN_SCOPE=agent:orchestration

# App #2b — Client Credentials + Token Exchange. Token endpoint auth: client_secret_basic.
AGENT_DELEGATION_CLIENT_ID=
AGENT_DELEGATION_CLIENT_SECRET=
# Scoped to "I'm delegating a task" — generic, never todos:read/write or
# any other downstream-specific scope; this service doesn't decide that,
# the Task Agent does via its own further exchange. Must be defined as a
# scope on a PingOne resource whose audience is the TASK AGENT's own URL
# (TASK_AGENT_URL below) — that resource's `aud` is what the Task Agent
# checks the resulting token against.
AGENT_DELEGATION_SCOPE=agent:delegation
#
# IMPORTANT: the resource behind AGENT_DELEGATION_SCOPE must be configured
# to issue JWT (not opaque/reference) access tokens — inbound auth can
# only cryptographically verify a JWT.
AGENT_EXPECTED_AUDIENCE=

# --- Session cookie encryption (required if either block above is used) ---
# Any long random string; it's hashed to a 32-byte key for JWE A256GCM.
SESSION_SECRET=

# --- LangGraph agent --------------------------------------------------------
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5

# --- A2A: delegation to the Task Agent (see task-agent/) --------------------
# The Chat Agent forwards its own delegated token to this URL — see
# CLAUDE.md "Identity propagation across the A2A hop". task-agent/.env's
# OIDC_DISCOVERY_URL / AGENT_EXPECTED_AUDIENCE must match this service's.
TASK_AGENT_URL=http://localhost:9010

# --- Networking --------------------------------------------------------------
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
